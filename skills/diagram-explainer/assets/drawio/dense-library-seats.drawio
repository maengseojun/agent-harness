666666666665" y="2349" width="136.66666666666666" height="43" as="geometry" /></mxCell><mxCell id="cases-516" parent="1" vertex="1" value="0" style="rounded=0;arcSize=12;html=0;whiteSpace=wrap;fillColor=#F3EFF9;strokeColor=#D7CBE6;fontFamily=나눔손글씨 다행체;fontSize=26;fontColor=#283E4D;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=10;"><mxGeometry x="2038.3333333333335" y="2349" width="136.66666666666666" height="43" as="geometry" /></mxCell><mxCell id="cases-517" parent="1" vertex="1" value="0명" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=25;fontColor=#8261AB;fontStyle=0;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="2189" y="2355" width="135" height="36" as="geometry" /></mxCell><mxCell id="cases-518" parent="1" vertex="1" value="각 칸: 시작 시점 인원 / 마지막 숫자: 60분" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=24;fontColor=#6B7D87;fontStyle=0;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="1355" y="2400" width="900" height="36" as="geometry" /></mxCell><mxCell id="cases-519" parent="1" vertex="1" value="10분부터 미입실 배정과 대기를 종료하고 새 배정을 하지 않는다.&#10;60분 O=0은 이 예시의 종료 조건. 실제 퇴실 보장이나 자동 퇴실 기능을 주장하지 않는다." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=29;fontColor=#283E4D;fontStyle=0;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="1254" y="2450" width="1070" height="80" as="geometry" /></mxCell><mxCell id="cases-520" parent="1" vertex="1" value="읽는 순서  ① 상황과 사건 → ② 같은 축의 좌석 변화 → ③ 운영 / 대기 레인 → ④ 결과의 이유     |     정의·배정 규칙·예외·데이터는 2페이지" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=27;fontColor=#6B7D87;fontStyle=0;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="50" y="2610" width="2300" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="rules" name="02 데이터와 배정 규칙"><mxGraphModel page="1" pageWidth="2400" pageHeight="2650" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="rules-1" parent="1" vertex="1" value="좌석 숫자에서 배정 규칙까지: 하루 운영을 한눈에 읽기" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=54;fontColor=#283E4D;fontStyle=1;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="50" y="35" width="2300" height="80" as="geometry" /></mxCell><mxCell id="rules-2" parent="1" vertex="1" value="1페이지의 상황을 해석하는 기준 · 범위: 단일 공간 120석 / 단일 대기열 / 입실 유예 10분 · 전부 합성 예시" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=31;fontColor=#6B7D87;fontStyle=0;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="50" y="120" width="2300" height="75" as="geometry" /></mxCell><mxCell id="rules-3" parent="1" vertex="1" value="A · 무엇을 세는가?" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=38;fontColor=#283E4D;fontStyle=1;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="50" y="213" width="1100" height="55" as="geometry" /></mxCell><mxCell id="rules-4" parent="1" vertex="1" value="" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#F5F8FA;strokeColor=#CCD5DB;fontFamily=나눔손글씨 다행체;fontSize=31;fontColor=#283E4D;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=10;"><mxGeometry x="50" y="285" width="1110" height="355" as="geometry" /></mxCell><mxCell id="rules-5" parent="1" vertex="1" value="O 사용 중    H 배정 후 미입실    F 배정 가능한 빈 좌석&#10;U 중단 좌석    Q 아직 배정받지 못한 대기자(명)" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=33;fontColor=#283E4D;fontStyle=0;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="75" y="305" width="1060" height="105" as="geometry" /></mxCell><mxCell id="rules-6" parent="1" vertex="1" value="좌석 보존: O + H + F + U = 120&#10;가동 좌석 C = 120 − U      사용률 = O / C" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=37;fontColor=#247EAE;fontStyle=1;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="75" y="435" width="1060" height="105" as="geometry" /></mxCell><mxCell id="rules-7" parent="1" vertex="1" value="Q는 사람 수이며 좌석 합계에 더하지 않는다. H는 O와 중복되지 않는다.&#10;C=0이면 사용률은 0%가 아니라 계산 불가이다." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=28;fontColor=#6B7D87;fontStyle=0;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="75" y="555" width="1060" height="75" as="geometry" /></mxCell><mxCell id="rules-8" parent="1" vertex="1" value="B · 비어 보이는 자리 24석, 배정 가능은 0석" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=38;fontColor=#283E4D;fontStyle=1;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="1230" y="213" width="1120" height="55" as="geometry" /></mxCell><mxCell id="rules-9" parent="1" vertex="1" value="" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#FFF9EF;strokeColor=#DECDAF;fontFamily=나눔손글씨 다행체;fontSize=31;fontColor=#283E4D;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=10;"><mxGeometry x="1230" y="285" width="1120" height="355" as="geometry" /></mxCell><mxCell id="rules-10" parent="1" vertex="1" value="13시 스냅샷: O=96, H=24, F=0, U=0, Q=18" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=34;fontColor=#283E4D;fontStyle=0;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="1255" y="305" width="1070" height="55" as="geometry" /></mxCell><mxCell id="rules-11" parent="1" vertex="1" value="사용률 = 96 / 120 = 80%&#10;배정까지 포함한 확보율 = (96 + 24) / 120 = 100%" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=36;fontColor=#BC842D;fontStyle=1;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="1255" y="375" width="1070" height="115" as="geometry" /></mxCell><mxCell id="rules-12" parent="1" vertex="1" value="80% 사용률이어도 빈 24석은 다른 이용자의 입실을 기다린다.&#10;만료 → 회수 → 재배정 → 새 입실을 거쳐야 사용 O가 늘어난다." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=31;fontColor=#283E4D;fontStyle=0;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="1255" y="520" width="1060" height="85" as="geometry" /></mxCell><mxCell id="rules-13" parent="1" vertex="1" value="C · 하루의 좌석 구성과 대기열" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=38;fontColor=#283E4D;fontStyle=1;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="50" y="690" width="2300" height="55" as="geometry" /></mxCell><mxCell id="rules-14" parent="1" vertex="1" value="시각" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=29;fontColor=#283E4D;fontStyle=1;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="60" y="770" width="140" height="50" as="geometry" /></mxCell><mxCell id="rules-15" parent="1" vertex="1" value="O(석)" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=29;fontColor=#283E4D;fontStyle=1;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="220" y="770" width="105" height="50" as="geometry" /></mxCell><mxCell id="rules-16" parent="1" vertex="1" value="H(석)" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=29;fontColor=#283E4D;fontStyle=1;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="345" y="770" width="105" height="50" as="geometry" /></mxCell><mxCell id="rules-17" parent="1" vertex="1" value="F(석)" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=29;fontColor=#283E4D;fontStyle=1;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="470" y="770" width="105" height="50" as="geometry" /></mxCell><mxCell id="rules-18" parent="1" vertex="1" value="U(석)" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=29;fontColor=#283E4D;fontStyle=1;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="595" y="770" width="105" height="50" as="geometry" /></mxCell><mxCell id="rules-19" parent="1" vertex="1" value="Q(명)" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=29;fontColor=#283E4D;fontStyle=1;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="720" y="770" width="105" height="50" as="geometry" /></mxCell><mxCell id="rules-20" parent="1" vertex="1" value="O/C" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=29;fontColor=#283E4D;fontStyle=1;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="845" y="770" width="155" height="50" as="geometry" /></mxCell><mxCell id="rules-21" edge="1" parent="1" value="" style="endArrow=none;startArrow=none;strokeColor=#283E4D;strokeWidth=2;dashed=0;rounded=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="822" as="sourcePoint" /><mxPoint x="1010" y="822" as="targetPoint" /></mxGeometry></mxCell><mxCell id="rules-22" parent="1" vertex="1" value="09:00" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=29;fontColor=#283E4D;fontStyle=0;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="60" y="835" width="140" height="60" as="geometry" /></mxCell><mxCell id="rules-23" parent="1" vertex="1" value="48" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=29;fontColor=#283E4D;fontStyle=0;align=right;verticalAlign=top;spacing=0;"><mxGeometry x="220" y="835" width="105" height="60" as=