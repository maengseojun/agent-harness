okeColor=none;fontFamily=나눔손글씨 다행체;fontSize=26;fontColor=#FFFFFF;fontStyle=0;align=center;verticalAlign=top;spacing=0;"><mxGeometry x="1355" y="1233" width="440.0" height="33" as="geometry" /></mxCell><mxCell id="rules-135" parent="1" vertex="1" value="" style="rounded=0;arcSize=12;html=0;whiteSpace=wrap;fillColor=#208C72;strokeColor=#208C72;fontFamily=나눔손글씨 다행체;fontSize=31;fontColor=#283E4D;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=10;"><mxGeometry x="1795.0" y="1230" width="440.0" height="38" as="geometry" /></mxCell><mxCell id="rules-136" parent="1" vertex="1" value="60" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=26;fontColor=#FFFFFF;fontStyle=0;align=center;verticalAlign=top;spacing=0;"><mxGeometry x="1795.0" y="1233" width="440.0" height="33" as="geometry" /></mxCell><mxCell id="rules-137" parent="1" vertex="1" value="22:00" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=28;fontColor=#283E4D;fontStyle=0;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="1200" y="1295" width="125" height="42" as="geometry" /></mxCell><mxCell id="rules-138" parent="1" vertex="1" value="" style="rounded=0;arcSize=12;html=0;whiteSpace=wrap;fillColor=#208C72;strokeColor=#208C72;fontFamily=나눔손글씨 다행체;fontSize=31;fontColor=#283E4D;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=10;"><mxGeometry x="1355.0" y="1295" width="880.0" height="38" as="geometry" /></mxCell><mxCell id="rules-139" parent="1" vertex="1" value="120" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=26;fontColor=#FFFFFF;fontStyle=0;align=center;verticalAlign=top;spacing=0;"><mxGeometry x="1355.0" y="1298" width="880.0" height="33" as="geometry" /></mxCell><mxCell id="rules-140" parent="1" vertex="1" value="0" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=25;fontColor=#283E4D;fontStyle=0;align=center;verticalAlign=top;spacing=0;"><mxGeometry x="1333.0" y="1380" width="50" height="35" as="geometry" /></mxCell><mxCell id="rules-141" parent="1" vertex="1" value="30" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=25;fontColor=#283E4D;fontStyle=0;align=center;verticalAlign=top;spacing=0;"><mxGeometry x="1553.0" y="1380" width="50" height="35" as="geometry" /></mxCell><mxCell id="rules-142" parent="1" vertex="1" value="60" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=25;fontColor=#283E4D;fontStyle=0;align=center;verticalAlign=top;spacing=0;"><mxGeometry x="1773.0" y="1380" width="50" height="35" as="geometry" /></mxCell><mxCell id="rules-143" parent="1" vertex="1" value="90" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=25;fontColor=#283E4D;fontStyle=0;align=center;verticalAlign=top;spacing=0;"><mxGeometry x="1993.0" y="1380" width="50" height="35" as="geometry" /></mxCell><mxCell id="rules-144" parent="1" vertex="1" value="120" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=25;fontColor=#283E4D;fontStyle=0;align=center;verticalAlign=top;spacing=0;"><mxGeometry x="2213.0" y="1380" width="50" height="35" as="geometry" /></mxCell><mxCell id="rules-145" parent="1" vertex="1" value="전체 길이 = 120석 · 매 행 같은 척도 · 숫자는 스냅샷, 하루 이용자 총수 아님" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=27;fontColor=#6B7D87;fontStyle=0;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="1200" y="1425" width="1125" height="70" as="geometry" /></mxCell><mxCell id="rules-146" parent="1" vertex="1" value="시간 관찰: 17시 중단 이후 분모 100석. 21시에는 중단 해제·신규 배정 종료.&#10;표는 다음 배정 전일 수 있어 Q와 F가 함께 남는다. 평균 대기시간은 알 수 없다." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=28;fontColor=#6B7D87;fontStyle=0;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="50" y="1410" width="1080" height="95" as="geometry" /></mxCell><mxCell id="rules-147" parent="1" vertex="1" value="D · 언제 배정 가능한가? 공동 조건이지 세 단계가 아니다" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=38;fontColor=#283E4D;fontStyle=1;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="50" y="1560" width="2300" height="55" as="geometry" /></mxCell><mxCell id="rules-148" parent="1" vertex="1" value="신규 배정 허용" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#EDF4FA;strokeColor=#247EAE;fontFamily=나눔손글씨 다행체;fontSize=30;fontColor=#283E4D;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=10;"><mxGeometry x="50" y="1640" width="380" height="58" as="geometry" /></mxCell><mxCell id="rules-149" parent="1" vertex="1" value="유효한 대기자 Q &gt; 0" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#EDF4FA;strokeColor=#247EAE;fontFamily=나눔손글씨 다행체;fontSize=30;fontColor=#283E4D;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=10;"><mxGeometry x="50" y="1717" width="380" height="58" as="geometry" /></mxCell><mxCell id="rules-150" parent="1" vertex="1" value="빈 좌석 F &gt; 0" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#EDF4FA;strokeColor=#247EAE;fontFamily=나눔손글씨 다행체;fontSize=30;fontColor=#283E4D;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=10;"><mxGeometry x="50" y="1794" width="380" height="58" as="geometry" /></mxCell><mxCell id="rules-151" parent="1" vertex="1" value="AND" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#FFF6E5;strokeColor=#BC842D;fontFamily=나눔손글씨 다행체;fontSize=33;fontColor=#283E4D;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=10;"><mxGeometry x="525" y="1706" width="145" height="80" as="geometry" /></mxCell><mxCell id="rules-152" parent="1" vertex="1" value="최대 min(F, Q)명 배정&#10;접수 시각이 빠른 순서(FIFO)" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#EEF7F3;strokeColor=#208C72;fontFamily=나눔손글씨 다행체;fontSize=32;fontColor=#283E4D;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=10;"><mxGeometry x="830" y="1690" width="610" height="140" as="geometry" /></mxCell><mxCell id="rules-153" edge="1" parent="1" value="" style="endArrow=none;startArrow=none;strokeColor=#247EAE;strokeWidth=2;dashed=0;rounded=0;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.2;entryPerimeter=0;" source="rules-148" target="rules-151"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="475" y="1669" /><mxPoint x="475" y="1722.0" /></Array></mxGeometry></mxCell><mxCell id="rules-154" edge="1" parent="1" value="" style="endArrow=none;startArrow=none;strokeColor=#247EAE;strokeWidth=2;dashed=0;rounded=0;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" source="rules-149" target="rules-151"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="475" y="1746" /><mxPoint x="475" y="1746.0" /></Array></mxGeometry></mxCell><mxCell id="rules-155" edge="1" parent="1" value="" style="endArrow=none;startArrow=none;strokeColor=#247EAE;strokeWidth=2;dashed=0;rounded=0;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.8;entryPerimeter=0;" source="rules-150" target="rules-151"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="475" y="1823" /><mxPoint x="475" y="1770.0" /></Array></mxGeometry></mxCell><mxCell id="rules-156" edge="1" parent="1" value="조건 결론" style="endArrow=classic;startArrow=none;strokeColor=#283E4D;strokeWidth=2;dashed=0;rounded=0;fontFamily=나눔손글씨 다행체;fontSize=25;fontColor=#283E4D;labelBackgroundColor=#FFFFFF;labelBorderColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" source="rules-151" target="rules-152"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-5" as="offset" /></mxGeometry></mxCell><mxCell id="rules-157" parent="1" vertex="1" value="배정 작업 실행 때 원자적으로 F → H.&#10;새 입실 때 H → O.&#10;동일 시각은 요청 ID 순서로 결정한다." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=32;fontColor=#283E4D;fontStyle=0;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="1490" y="1650" width="860" height="140" as="geometry" /></mxCell><mxCell id="rules-158" parent="1" vertex="1" value="예시: F=12, Q=18 → 12명 배정 → H +12, F −12, Q 18 → 6명&#10;입실 확인 전에는 O가 늘지 않는다. 정지·종료 중에는 빈 좌석이 있어도 신규 배정하지 않는다." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=31;fontColor=#283E4D;fontStyle=0;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="50" y="1905" width="2300" height="90" as="geometry" /></mxCell><mxCell id="rules-159" parent="1" vertex="1" value="E · 이용자 상태와 시스템 책임: 정지 / 만료는 다른 분기" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=38;fontColor=#283E4D;fontStyle=1;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="50" y="2060" width="2300" height="55" as="geometry" /></mxCell><mxCell id="rules-160" parent="1" vertex="1" value="" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#F7F9FA;strokeColor=#BBC8CF;fontFamily=나눔손글씨 다행체;fontSize=31;fontColor=#283E4D;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=10;"><mxGeometry x="50" y="2140" width="2300" height="345" as="geometry" /></mxCell><mxCell id="rules-161" parent="1" vertex="1" value="이용자&#10;대기 신청 / 입실 확인" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#BBC8CF;fontFamily=나눔손글씨 다행체;fontSize=31;fontColor=#283E4D;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=10;"><mxGeometry x="85" y="2200" width="375" height="90" as="geometry" /></mxCell><mxCell id="rules-162" parent="1" vertex="1" value="배정기&#10;FIFO / F → H" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#EDF4FA;strokeColor=#247EAE;fontFamily=나눔손글씨 다행체;fontSize=31;fontColor=#283E4D;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=10;"><mxGeometry x="575" y="2200" width="390" height="90" as="geometry" /></mxCell><mxCell id="rules-163" parent="1" vertex="1" value="좌석 원장&#10;H → O / O → F" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#EEF7F3;strokeColor=#208C72;fontFamily=나눔손글씨 다행체;fontSize=31;fontColor=#283E4D;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=10;"><mxGeometry x="1090" y="2200" width="420" height="90" as="geometry" /></mxCell><mxCell id="rules-164" parent="1" vertex="1" value="관리자&#10;정지·복구 / F ↔ U" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#F3EFF9;strokeColor=#8261AB;fontFamily=나눔손글씨 다행체;fontSize=31;fontColor=#283E4D;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=10;"><mxGeometry x="1630" y="2200" width="390" height="90" as="geometry" /></mxCell><mxCell id="rules-165" edge="1" parent="1" value="요청" style="endArrow=classic;startArrow=none;strokeColor=#283E4D;strokeWidth=2;dashed=0;rounded=0;fontFamily=나눔손글씨 다행체;fontSize=25;fontColor=#283E4D;labelBackgroundColor=#F7F9FA;labelBorderColor=none;" source="rules-161" target="rules-162"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-5" as="offset" /></mxGeometry></mxCell><mxCell id="rules-166" edge="1" parent="1" value="배정 기록" style="endArrow=classic;startArrow=none;strokeColor=#283E4D;strokeWidth=2;dashed=0;rounded=0;fontFamily=나눔손글씨 다행체;fontSize=25;fontColor=#283E4D;labelBackgroundColor=#F7F9FA;labelBorderColor=none;" source="rules-162" target="rules-163"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-5" as="offset" /></mxGeometry></mxCell><mxCell id="rules-167" edge="1" parent="1" value="가동 상태" style="endArrow=classic;startArrow=none;strokeColor=#8261AB;strokeWidth=2;dashed=0;rounded=0;fontFamily=나눔손글씨 다행체;fontSize=25;fontColor=#8261AB;labelBackgroundColor=#F7F9FA;labelBorderColor=none;" source="rules-164" target="rules-163"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-5" as="offset" /></mxGeometry></mxCell><mxCell id="rules-168" edge="1" parent="1" value="" style="endArrow=none;startArrow=none;strokeColor=#6B7D87;strokeWidth=1;dashed=0;rounded=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="2290" as="sourcePoint" /><mxPoint x="270" y="2370" as="targetPoint" /></mxGeometry></mxCell><mxCell id="rules-169" edge="1" parent="1" value="입실 확인" style="endArrow=none;startArrow=none;strokeColor=#6B7D87;strokeWidth=1;dashed=0;rounded=0;fontFamily=나눔손글씨 다행체;fontSize=25;fontColor=#6B7D87;labelBackgroundColor=#F7F9FA;labelBorderColor=none;"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="2370" as="sourcePoint" /><mxPoint x="1300" y="2370" as="targetPoint" /><mxPoint x="0" y="-5" as="offset" /></mxGeometry></mxCell><mxCell id="rules-170" edge="1" parent="1" value="" style="endArrow=classic;startArrow=none;strokeColor=#6B7D87;strokeWidth=1;dashed=0;rounded=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="2370" as="sourcePoint" /><mxPoint x="1300" y="2290" as="targetPoint" /></mxGeometry></mxCell><mxCell id="rules-171" parent="1" vertex="1" value="만료 담당: 10분 미입실 → H → F, 해당 배정 종료. 자동 재신청하지 않는다.&#10;배정 정지: 기존 사용·퇴실·만료 유지. 복구하면 남은 대기 순서로 재개. 종료: 대기·H를 취소하고 새 배정 금지." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=27;fontColor=#283E4D;fontStyle=0;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="85" y="2415" width="2220" height="65" as="geometry" /></mxCell><mxCell id="rules-172" parent="1" vertex="1" value="범위·한계: 실제 학교 운영 규칙·인증/개인정보·다중 공간·우선순위·평균 대기시간·이용자 총수·구현 코드는 다루지 않는다.&#10;출처: 이 문서용 합성 데이터와 가상 규칙 / 2026-10-13 / JSON 함께 제공. 1페이지 사례는 서로 독립이며 하루 표와 이어 붙이지 않는다." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=나눔손글씨 다행체;fontSize=28;fontColor=#6B7D87;fontStyle=0;align=left;verticalAlign=top;spacing=0;"><mxGeometry x="50" y="2520" width="2300" height="100" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>