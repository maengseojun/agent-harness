  "routes": {
    "research_collect_light": {
      "when": "quick, bulk or watch research: one fact, bulk gathering, re-check of a known scope. No judgment; the range is fixed",
      "resource": "aside",
      "model": "gpt-6.1-sol",
      "effort": "high",
      "standby": [],
      "enforcedBy": "skill",
      "where": "plugins/maeng-tools/skills/aside-collect/SKILL.md",
      "decidedBy": "user 2026-11-07 (effort stated; the model follows from Astra being named for deep research)",
      "verifiedAt": null
    },
    "research_collect_deep": {
      "when": "deep research, from the start or built on the facts of a light run",
      "resource": "aside",
      "model": "gpt-6-astra",
      "effort": "medium",
      "standby": [],
      "enforcedBy": "skill",
      "where": "plugins/maeng-tools/skills/aside-collect/SKILL.md",
      "decidedBy": "user 2026-11-07",
      "verifiedAt": null
    },
    "research_triage": {
      "when": "choosing which search results to open",
