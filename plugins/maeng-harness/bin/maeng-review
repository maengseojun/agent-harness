#!/usr/bin/env python3
"""maeng-review: build a review bundle, run the isolated Codex reviewer, store verdicts, reconcile receipts."""
import argparse
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from maeng import evidence, guard, receipts, schema, state  # noqa: E402
from maeng import tree as treelib  # noqa: E402
from maeng.cli_common import die, require_personal  # noqa: E402
from maeng.common import canonical, git, git_out, home_dir, sha256, write_json  # noqa: E402

CODEX_CANDIDATES = (  # verified live 2026-10-17; the npm codex install on this Mac is broken
    "/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex",
    "/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex",
)
DEFAULT_CODEX = next((c for c in CODEX_CANDIDATES if os.access(c, os.X_OK)), CODEX_CANDIDATES[0])
ASTRA, SOL = "gpt-6-astra", "gpt-6.1-sol"
# Feature families to switch off for an isolated reviewer (design §4). Exact names vary by Codex version,
# so they are matched against `codex features list` at run time; unknown names are never passed.
DISABLE_FAMILIES = ("apps", "browser", "computer_use", "hooks", "plugin", "memories", "multi_agent", "image",
                    "skill", "view_image")
PROMPT = """You are an independent, adversarial reviewer. Review ONLY the bundle below.
Rules: you are read-only; do not use skills, plugins, browsers or any tool that needs approval.
Threat model (user decision): the agent is cooperative. Hooks and gates are guardrails against mistakes and
convenience shortcuts, not a security boundary; a deliberately disguised route (for example a script with an
innocuous name that pushes) is out of scope and is not a finding. Judge against that model: every KNOWN,
non-disguised route must still be gated, and every gate must fail closed when it cannot decide. Report a gap in
a known route or a gate that fails open; do not report out-of-scope disguised bypasses.
Shipping and cross-world gating is an ALLOWLIST of canonical forms, by design: a Bash command that mentions a
shipping route is allowed only as one plain single command in one of these forms: `git push [-u] <remote>
<branch>`, `git push [-u] <remote> <branch-or-sha>:<refs/heads/name|name>`, maeng-ship's exact lease push
(`git push --force-with-lease=refs/heads/<base>:<sha> <remote> <sha>:refs/heads/<base>`), `gh pr create --repo <owner/repo>` (the
repo must equal origin) with only --base/--head/--title/--body/--body-file/--draft/--repo, `maeng-ship merge <N>`,
read-only gh commands, and gh pr/issue writes (comment/edit/review/ready/close, issue *) that carry an explicit
`-R <owner/repo>` (never eta). gh checkout/clone/download commands are local writes gated by the effective directory.
Cross-world gate G3 is TOKEN TAINT with a read-only allowlist: in a personal session every token of every Bash
segment (option values, key=value values, redirect targets, bare operands, owner/repo slugs, github.com URLs) is
resolved against the segment's effective directory (tracking cd) and against the eta repository classification;
a segment with any eta-tainted token, or running in an eta/unknown directory, is denied unless its program is on a
small read-only allowlist used without mutation options. Verify that allowlist is closed (no mutating option or
subcommand slips through). Verification evidence is a RUNNER INVOCATION ALLOWLIST: a command counts as evidence
only when it matches a canonical runner form with allowlisted flags (pytest, unittest, npm/pnpm/yarn scripts, forge,
cargo, go test, make targets, ruff check, mypy, tsc, claude plugin validate, playwright test); any other flag
(dry-run, list, collect-only, ...) makes it no evidence. Verify that these lists are closed. Everything else (compound commands, wrappers, env assignments, `git -c/-C/--git-dir`, substitutions,
redirects, other flags) is denied by design, so do NOT enumerate disguised or non-canonical variants as findings.
Instead verify that the allowlist is closed (no route reaches the shell without passing it) and that each
canonical form is fully checked (remote configuration, default branch, verified tree/remote head, receipts,
repository binding, eta isolation).
Files listed as delegated (files_delegated / scope.delegated_files) are OUT of this review's scope but are NOT
covered by it: they still need their own passing review. Files listed as excluded are exempt.
Start from the assumption that the change is wrong; try to falsify it against the acceptance criteria (AC-n).
Answer with JSON matching the supplied schema. verdict=pass only if no critical/high finding remains and every AC is met.
Use verdict=blocked if the bundle lacks something required.

BUNDLE:
"""


def tier_for(kind, binding):
    if kind == "parent":
        return ASTRA, "xhigh"
    if kind == "docs":
        return ASTRA, "high"
    if kind == "notion":
        return SOL, "medium"
    if binding and binding.get("parent") and binding.get("criteria"):
        return ASTRA, "medium"
    return SOL, "xhigh"


def features_to_disable(codex):
    """Enabled Codex features whose name matches a family we must switch off."""
    try:
        out = subprocess.run([codex, "features", "list"], capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    names = []
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[-1] == "true" and any(fam in parts[0] for fam in DISABLE_FAMILIES):
            names.append(parts[0])
    return names


def codex_command(model, effort, schema_path, out_path):
    codex = os.environ.get("MAENG_CODEX") or DEFAULT_CODEX
    cmd = [codex, "exec", "--ignore-user-config", "--ignore-rules"]
    for feature in features_to_disable(codex):
        cmd += ["--disable", feature]
    cmd += ["--sandbox", "read-only", "-c", 'approval_policy="never"', "--ephemeral",
            "-m", model, "-c", f'model_reasoning_effort="{effort}"',
            "--output-schema", str(schema_path), "-o", str(out_path), "-"]
    return cmd


def plan_text(binding):
    """Full Spec/Plan text so the reviewer can judge each AC-n, not just its id."""
    doc = binding.get("plan_doc")
    if doc and Path(doc).is_file():
        return Path(doc).read_text(encoding="utf-8", errors="replace")
    return None


def read_evidence_files(paths):
    out = {}
    for p in paths or []:
        try:
            out[str(p)] = Path(p).read_text(encoding="utf-8", errors="replace")
        except OSError as exc:
            out[str(p)] = f"<unreadable: {exc}>"
    return out


def code_bundle(a, cwd, st):
    missing = []
    base, head = a.base, a.head
    if not (base and head):
        missing.append("base/head SHAs")
        return {"missing": missing}
    delegate = list(a.delegate or [])
    spec = list(a.path or []) + [f":(exclude){x}" for x in [*(a.exclude or []), *delegate]]
    tail = ["--", *spec] if spec else []
    diff = git_out(cwd, "diff", "--no-renames", f"{base}...{head}", *tail) or ""
    files = sorted(set((git_out(cwd, "diff", "--name-only", "--no-renames", f"{base}...{head}", *tail) or "").splitlines()))
    excluded, delegated = [], []
    if spec:
        every = (git_out(cwd, "diff", "--name-only", "--no-renames", f"{base}...{head}") or "").splitlines()
        if delegate:  # delegated files are reviewed elsewhere and are never exempt
            delegated = sorted(set((git_out(cwd, "diff", "--name-only", "--no-renames", f"{base}...{head}", "--",
                                            *delegate) or "").splitlines()))
        excluded = sorted(set(every) - set(files) - set(delegated))
    contents = {}
    for f in files:
        rc, out, _ = git(cwd, "show", f"{head}:{f}")
        if rc == 0:
            contents[f] = out
    binding = st.get("binding") or {}
    tree = treelib.commit_tree(cwd, head)
    top, common = treelib.toplevel(cwd), treelib.common_dir(cwd)
    ok, reasons = evidence.Verifier(st, top, common).ship_verified(tree)
    ev = [e for e in st.get("evidence", []) if e.get("common") == common]
    if not ev:
        missing.append("verification evidence")
    if binding.get("criteria") is None or not binding.get("criteria"):
        missing.append("Spec/Plan AC-n criteria")
    elif not plan_text(binding):
        missing.append("Spec/Plan text (bind with --plan <file>)")
    evidence_files = read_evidence_files(a.evidence)
    size = len(diff) + sum(len(v) for v in contents.values()) + sum(len(v) for v in evidence_files.values())
    if size > a.max_bytes:
        missing.append(f"bundle is {size} bytes (> --max-bytes {a.max_bytes}); narrow it with --path/--exclude")
    remote_url = git_out(cwd, "remote", "get-url", "--push", a.remote)
    return {"kind": a.kind, "repo": guard.normalize_repo(remote_url), "pr": a.pr, "files_reviewed": files,
            "evidence_files": evidence_files,
            "scope": {"paths": a.path or [], "exclude": a.exclude or [], "excluded_files": excluded,
                      "delegate": delegate, "delegated_files": delegated,
                      "exclusion_reason": a.exclusion_reason},
            "base": base, "head": head, "diff": diff, "changed_files": contents,
            "criteria": binding.get("criteria"), "criteria_rev": binding.get("plan_updated_at"),
            "plan_text": plan_text(binding), "required_checks": binding.get("checks"),
            "evidence": ev, "ship_verified": ok, "ship_verified_reasons": reasons, "missing": missing}


def run_review(a, cwd):
    require_personal(cwd)
    sid = a.session or state.find_session(cwd)
    st = state.load(sid, cwd) if sid else state.fresh("none", cwd)
    if a.kind == "notion":
        payload = json.loads(Path(a.payload).read_text())
        digest = sha256(canonical(payload))
        bundle = {"kind": "notion", "payload": payload, "digest": digest, "destination": receipts.nid(a.destination),
                  "op": a.op, "draft": a.draft and Path(a.draft).read_text(), "sources": a.source or [],
                  "evidence_files": read_evidence_files(a.evidence),
                  "missing": [] if a.destination and a.op else ["destination/op"]}
        total = len(json.dumps(payload)) + sum(len(v) for v in bundle["evidence_files"].values())
        if total > a.max_bytes:
            bundle["missing"].append(f"bundle is {total} bytes (> --max-bytes {a.max_bytes})")
        subject = {"kind": "notion", "repo": None, "pr": None, "base": None, "head": None, "criteria_rev": None,
                   "digest": digest, "destination": receipts.nid(a.destination), "op": a.op}
    else:
        bundle = code_bundle(a, cwd, st)
        diff_digest = sha256(bundle.get("diff", ""))
        subject = {"kind": a.kind, "repo": bundle.get("repo"), "pr": a.pr, "base": a.base, "head": a.head,
                   "criteria_rev": bundle.get("criteria_rev"), "digest": diff_digest,
                   "files_reviewed": bundle.get("files_reviewed", []),
                   "files_excluded": (bundle.get("scope") or {}).get("excluded_files", []),
                   "files_delegated": (bundle.get("scope") or {}).get("delegated_files", []),
                   "exclusion_reason": (bundle.get("scope") or {}).get("exclusion_reason"),
                   "destination": f"refs/heads/{a.base_ref}" if a.base_ref else None, "op": "merge"}
        if not a.base_ref:
            bundle.setdefault("missing", []).append("base ref name (--base-ref)")
    model, effort = tier_for(a.kind, st.get("binding"))
    if bundle["missing"]:
        verdict = {"verdict": "blocked", "subject": subject, "reviewer": {"model": model, "effort": effort},
                   "findings": [{"severity": "high", "title": "bundle incomplete", "body": ", ".join(bundle["missing"]),
                                 "file": None, "line": None}]}
        print(json.dumps(verdict, indent=2))
        return 2
    full = schema.load_schema()
    out_schema = {**full["$defs"]["reviewer_output"], "$defs": full["$defs"]}
    with tempfile.TemporaryDirectory(prefix="maeng-review-") as d:
        schema_path, out_path = Path(d, "schema.json"), Path(d, "out.json")
        write_json(schema_path, out_schema)
        proc = subprocess.run(codex_command(model, effort, schema_path, out_path), cwd=cwd,
                              input=PROMPT + json.dumps(bundle, indent=1), capture_output=True, text=True)
        if proc.returncode != 0 or not out_path.exists():
            die(f"reviewer failed (rc={proc.returncode}): {proc.stderr.strip()[:500]}")
        try:
            result = json.loads(out_path.read_text())
        except ValueError:
            die("reviewer output is not JSON")
    errors = schema.validate(result, out_schema)
    if errors:
        die("reviewer output violates schema: " + "; ".join(errors))
    verdict = {"verdict": result["verdict"], "subject": subject, "reviewer": {"model": model, "effort": effort},
               "findings": result["findings"]}
    if verdict["verdict"] == "pass":
        verdict_key = receipts.store_verdict(verdict)
    else:
        verdict_key = None
        receipts.revoke_passes(subject, verdict["verdict"])  # a failed re-review revokes earlier unconsumed passes
    reviews = home_dir() / "reviews"
    write_json(reviews / f"{sha256(canonical(verdict))[:16]}.json", verdict)
    print(json.dumps({"verdict": verdict["verdict"], "receipt": verdict_key, "findings": verdict["findings"]}, indent=2))
    return 0 if verdict["verdict"] == "pass" else 1


def reconcile(a, cwd):
    if a.notion:
        if a.absent:
            e = receipts.journal_absent(a.notion)
        elif a.page_id:
            e = receipts.journal_readback(a.page_id.replace("-", "").lower(), a.notion)
        else:
            die("--notion needs --page-id <id> (readback found it) or --absent (no such page)")
        print("reconciled" if e else "no matching unresolved journal entry")
        return 0
    pend = receipts.pending_code()
    if not pend:
        print("nothing pending")
    for rec in pend:
        outcome, detail = receipts.reconcile_code(rec["key"], a.repo or cwd)
        print(f"{rec['key']}: {outcome} {detail}")
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="maeng-review")
    p.add_argument("--session")
    sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("--kind", choices=["code", "parent", "docs", "notion"], default="code")
    r.add_argument("--pr"); r.add_argument("--base"); r.add_argument("--head"); r.add_argument("--base-ref")
    r.add_argument("--payload"); r.add_argument("--destination"); r.add_argument("--op")
    r.add_argument("--draft"); r.add_argument("--source", action="append")
    r.add_argument("--path", action="append", help="git pathspec to include (repeatable)")
    r.add_argument("--exclude", action="append", help="git pathspec to exclude (repeatable); listed in the bundle")
    r.add_argument("--delegate", action="append",
                   help="git pathspec reviewed by ANOTHER receipt (repeatable); not covered by this one")
    r.add_argument("--exclusion-reason", help="why excluded files need no review (shown to the reviewer)")
    r.add_argument("--remote", default="origin", help="remote whose repository the receipt is bound to")
    r.add_argument("--evidence", action="append", help="file whose contents are embedded as evidence_files (repeatable)")
    r.add_argument("--max-bytes", type=int, default=1_500_000, help="bundle size limit; larger bundles are blocked")
    c = sub.add_parser("reconcile"); c.add_argument("--repo"); c.add_argument("--notion")
    c.add_argument("--page-id"); c.add_argument("--absent", action="store_true")
    s = sub.add_parser("store"); s.add_argument("verdict_file")
    g = sub.add_parser("registry"); g.add_argument("action", choices=["seed"]); g.add_argument("ids", nargs="+")
    a = p.parse_args(argv)
    cwd = os.getcwd()
    if a.cmd == "run":
        sys.exit(run_review(a, cwd))
    if a.cmd == "reconcile":
        sys.exit(reconcile(a, cwd))
    if a.cmd == "store":
        print(receipts.store_verdict(json.loads(Path(a.verdict_file).read_text())))
    if a.cmd == "registry":
        receipts.registry_add([i.replace("-", "").lower() for i in a.ids])


if __name__ == "__main__":
    main()
