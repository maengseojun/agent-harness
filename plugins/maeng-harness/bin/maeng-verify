#!/usr/bin/env python3
"""maeng-verify: bind a session to an issue/plan and record verification facts."""
import argparse
import hashlib
import json
import os
import shlex
import subprocess
import sys
import time
import uuid

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from maeng import evidence, recordcheck, state  # noqa: E402
from maeng import tree as treelib  # noqa: E402
from maeng.cli_common import die, load_state, require_personal, session_for  # noqa: E402
from maeng.common import atomic_write, home_dir, read_json  # noqa: E402
from maeng.shellparse import ENV_ASSIGN  # noqa: E402


def need_tree(cwd):
    tree, info = treelib.tree_id(cwd)
    if not tree:
        die("no tree id (" + info.get("reason", "unknown") + "); no evidence can be recorded")
    return tree, treelib.common_dir(cwd)


def cmd_bind(a, cwd):
    sid = session_for(cwd, a.session)
    why = recordcheck.related_missing(state.load(sid, cwd))
    if why:
        die(why)
    binding = evidence.make_binding(
        a.issue, a.plan, a.plan_updated, a.criteria.split(",") if a.criteria else None, a.check or None, a.parent,
        treelib.toplevel(cwd))
    state.update(sid, lambda st: st.update(binding=binding, cwd=st.get("cwd") or cwd), cwd)
    sugg_path = home_dir() / "last-bindings.json"
    try:
        sugg = read_json(sugg_path, {}) or {}
    except ValueError:
        sugg = {}
    sugg[os.path.realpath(cwd)] = {"issue": a.issue, "plan_doc": a.plan}
    atomic_write(sugg_path, json.dumps(sugg, indent=1))
    reg_path = home_dir() / "bindings.json"  # issue -> current criteria rev, so a parent merge can tell a child's plan changed
    try:
        reg = read_json(reg_path, {}) or {}
    except ValueError:
        reg = {}
    reg[a.issue] = {"parent": a.parent, "criteria_rev": binding.get("criteria_rev")}
    atomic_write(reg_path, json.dumps(reg, indent=1))
    print(f"bound {a.issue}; criteria={binding['criteria']} checks={binding['checks']}")


def cmd_ran(a, cwd):
    tree, common = need_tree(cwd)
    sid = session_for(cwd, a.session)
    ok = a.ok
    state.update(sid, lambda st: evidence.add_evidence(st, a.what, "declared", a.what, ok, tree, tree, common, "declared"), cwd)
    if evidence.recognize(a.what):
        print("note: this is a runner command; a declaration never satisfies a runner requirement. "
              "Run it with `maeng-verify exec -- <runner ...>` to record runner evidence.", file=sys.stderr)
    print(f"recorded {'ok' if ok else 'FAIL'}: {a.what} at tree {tree[:10]}")


def cmd_exec(a, cwd):
    argv = list(a.command)
    if argv[:1] == ["--"]:
        argv = argv[1:]
    rec = evidence.recognize(shlex.join(argv)) if argv else None
    if not rec or rec["cd"] or len(rec["checks"]) != 1 or ENV_ASSIGN.match(argv[0]):
        die("not an allowlisted runner: `maeng-verify exec` runs only one recognized test/check runner invocation "
            "(e.g. `python3 -m pytest -q`), as argv without a shell", 2)
    tree_start, common = need_tree(cwd)
    sid = session_for(cwd, a.session)
    key = "exec-" + uuid.uuid4().hex[:12]
    command = shlex.join(argv)
    rel = evidence.rel_dir(cwd, treelib.toplevel(cwd))
    state.update(sid, lambda st: evidence.pre_runner(st, key, command, rec, tree_start, common, rel), cwd)
    digest, t0, rc = hashlib.sha256(), time.monotonic(), None
    head, tail = bytearray(), bytearray()  # kept for the zero-tests check
    try:
        proc = subprocess.Popen(argv, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        for chunk in iter(lambda: proc.stdout.read1(65536), b""):
            digest.update(chunk)
            if len(head) < 524288:
                head += chunk[:524288 - len(head)]
            tail += chunk
            del tail[:-524288]
            sys.stdout.buffer.write(chunk)
            sys.stdout.buffer.flush()
        rc = proc.wait()
    except OSError as exc:
        state.update(sid, lambda st: st["pending"].pop(key, None), cwd)
        die(f"cannot execute {argv[0]}: {exc}", 127)
    except KeyboardInterrupt:
        state.update(sid, lambda st: st["pending"].pop(key, None), cwd)
        raise
    duration = round(time.monotonic() - t0, 3)
    tree_finish, _ = treelib.tree_id(cwd)

    text = (tail if len(head) < 524288 else head + b"\n" + tail).decode("utf-8", "replace")  # tail holds all of a small output
    zero, count = rc == 0 and evidence.ran_zero_tests(text), evidence.test_count(text)

    def finish(st):
        if zero:
            st["pending"].pop(key, None)
            return
        for ev in evidence.post_runner(st, key, rc == 0, tree_finish, count):
            ev.update(exit_code=rc, duration_s=duration, output_sha256=digest.hexdigest())
    state.update(sid, finish, cwd)
    if zero:
        print("maeng-verify exec: the runner exited 0 but ran ZERO tests; nothing was recorded as evidence",
              file=sys.stderr)
    print(f"maeng-verify exec: exit {rc} in {duration}s; output sha256 {digest.hexdigest()[:12]}", file=sys.stderr)
    sys.exit(rc)


def cmd_state(a, cwd):
    sid = session_for(cwd, a.session)
    p = state.path_for(sid)
    if a.quarantine:
        dest = state.quarantine(sid)
        print(f"moved {p} to {dest}; restart the session" if dest else f"{p} is absent or readable; nothing to quarantine")
        return
    try:
        state.load(sid, cwd)
        print(f"{p}: ok" if p.exists() else f"{p}: absent")
    except state.StateCorrupt as exc:
        die(exc.message())


def cmd_skip(a, cwd):
    tree, common = need_tree(cwd)
    sid = session_for(cwd, a.session)
    state.update(sid, lambda st: evidence.add_skip(st, a.reason, tree, common), cwd)
    print(f"recorded skip at tree {tree[:10]} (a skip never makes a tree ship-verified)")


def cmd_plan(a, cwd):
    sid, st = load_state(cwd, a.session)
    b = st.get("binding")
    if not b:
        die("no binding: run `maeng-verify bind MAE-n --plan <doc>` first")
    tree, common = need_tree(cwd)
    met = [x for x in (a.met or "").split(",") if x]
    unmet = [x for x in (a.unmet or "").split(",") if x]
    state.update(sid, lambda s: evidence.add_plan_record(s, met, unmet, a.notes or "", tree, common, b.get("plan_updated_at")), cwd)
    print(f"plan record: met={met} unmet={unmet}")


def cmd_decision(a, cwd):
    sid = session_for(cwd, a.session)
    def add(st):
        st["decisions"].append({"seq": evidence.bump(st), "text": a.text})
        st["last_change_seq"] = st["seq"]
    state.update(sid, add, cwd)
    print("decision recorded; write it to Linear/Obsidian too")


def cmd_status(a, cwd):
    sid, st = load_state(cwd, a.session)
    tree, _ = treelib.tree_id(cwd)
    top, common = treelib.toplevel(cwd), treelib.common_dir(cwd)
    out = {"session": sid, "binding": st.get("binding"), "tree": tree}
    if tree and top:
        v = evidence.Verifier(st, top, common)
        ok, reasons = v.ship_verified(tree)
        out.update(ship_verified=ok, missing=reasons, stop_satisfied=v.stop_satisfied(tree),
                   required=v.required(), flaky=v.flaky(tree))
    print(json.dumps(out, indent=2))


def main(argv=None):
    p = argparse.ArgumentParser(prog="maeng-verify")
    p.add_argument("--session")
    sub = p.add_subparsers(dest="cmd", required=True)
    b = sub.add_parser("bind"); b.add_argument("issue"); b.add_argument("--plan"); b.add_argument("--plan-updated")
    b.add_argument("--criteria"); b.add_argument("--check", action="append"); b.add_argument("--parent")
    r = sub.add_parser("ran"); g = r.add_mutually_exclusive_group(required=True)
    g.add_argument("--ok", action="store_true"); g.add_argument("--fail", action="store_true"); r.add_argument("what")
    s = sub.add_parser("skip"); s.add_argument("reason")
    pl = sub.add_parser("plan"); pl.add_argument("--met"); pl.add_argument("--unmet"); pl.add_argument("notes", nargs="?")
    d = sub.add_parser("decision"); d.add_argument("text")
    sub.add_parser("status")
    e = sub.add_parser("exec"); e.add_argument("command", nargs=argparse.REMAINDER)
    stt = sub.add_parser("state"); stt.add_argument("--quarantine", action="store_true")
    a = p.parse_args(argv)
    cwd = os.getcwd()
    require_personal(cwd)
    try:
        {"bind": cmd_bind, "ran": cmd_ran, "skip": cmd_skip, "plan": cmd_plan, "decision": cmd_decision,
         "status": cmd_status, "exec": cmd_exec, "state": cmd_state}[a.cmd](a, cwd)
    except state.StateCorrupt as exc:
        die(exc.message())


if __name__ == "__main__":
    main()
